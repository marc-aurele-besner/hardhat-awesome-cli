{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "strict": true,
        "rootDirs": ["./src", "./test"],
        "types": ["node", "mocha"],
        "esModuleInterop": true
    },
    "exclude": ["dist", "node_modules"],
    "include": ["./test", "./src"]
}